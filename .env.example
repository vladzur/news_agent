# Clave API de DeepSeek (requerida)
# Obtenla desde https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-api-key-here

# Temas de interés prioritarios para la pauta (opcional)
# Array JSON de textos con comillas dobles. Si se define, el agente prioriza
# estos temas por sobre la distribución 3 nacionales / 2 internacionales.
# Ejemplo:
# MAIN_TOPICS=["genocidio en Gaza", "Agenda de seguridad", "Retrocesos laborales"]
